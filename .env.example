# Copy to .env and fill in. Never commit .env.
MODEL_PATH=weights/best.pt
# Direct download link to your weights (GitHub Release asset); used only if MODEL_PATH doesn't exist yet
WEIGHTS_URL=https://github.com/YOUR_USERNAME/rap-currency-detector/releases/download/v1.0/best.pt
DEVICE=cpu
# Any OpenAI-compatible chat endpoint. Groq example (check current model ids: GET https://api.groq.com/openai/v1/models)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
# Extra JSON merged into the request body; for reasoning models this keeps replies fast
LLM_EXTRA_BODY={"reasoning_effort":"low"}
